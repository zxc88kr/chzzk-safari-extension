{
  "manifest_version": 3,
  "name": "Chzzk Safari Extension",
  "version": "2.2.1",
  "description": "치지직 시청 편의 기능: 지연시간 표시·따라잡기, 방향키 탐색, 채팅 타임스탬프, 호버 미리보기, 사이드바 자동 갱신, 방송 시작 자동 새로고침",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://chzzk.naver.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "exclude_matches": [
        "*://chzzk.naver.com/chat/*",
        "*://chzzk.naver.com/embed/*",
        "*://chzzk.naver.com/error*"
      ],
      "js": [
        "common/defaults.js",
        "content/settings.js",
        "content/util.js",
        "content/flags.js",
        "content/player.js",
        "content/widescreen.js",
        "content/lumber.js",
        "content/unmute.js",
        "content/playerbuttons.js",
        "content/chat.js",
        "content/chatmacro.js",
        "content/preview.js",
        "content/sidebar.js",
        "content/expandfollowing.js",
        "content/autoreload.js",
        "content/channelchat.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "exclude_matches": [
        "*://chzzk.naver.com/chat/*",
        "*://chzzk.naver.com/embed/*",
        "*://chzzk.naver.com/error*"
      ],
      "js": [
        "content/quality-loader.js",
        "content/chattime-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/quality-main.js",
        "content/chattime-main.js"
      ],
      "matches": [
        "*://chzzk.naver.com/*"
      ]
    }
  ]
}
